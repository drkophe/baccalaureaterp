##############################################################################
# Serveur temps reel (apps/server)
##############################################################################

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Origines autorisees (CORS + Socket.io), separees par une virgule.
# En production : lister explicitement les domaines du front. "*" est refuse.
CORS_ORIGINS=http://localhost:3000

# Redis : obligatoire en production (etat de session partage + adapter Socket.io).
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=bacc

# Repli sur un store memoire si Redis est injoignable.
# Pratique en developpement, refuse au demarrage quand NODE_ENV=production.
ALLOW_MEMORY_STORE=false

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Nombre de proxies de confiance devant l'application (pour obtenir la vraie IP
# cliente derriere un load balancer / ingress).
TRUST_PROXY=1

# Desactive le rate limiting. A reserver aux tests automatises.
DISABLE_RATE_LIMIT=false

##############################################################################
# Front (apps/web) - variables exposees au navigateur
##############################################################################

# URL publique du serveur temps reel, vue depuis le navigateur.
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
