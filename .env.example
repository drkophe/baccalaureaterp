# Toutes ces variables sont OPTIONNELLES : l'application demarre sans aucune
# configuration. Copier ce fichier en `.env` uniquement si besoin.

# Port d'ecoute. La plupart des hebergeurs l'imposent automatiquement.
# PORT=3000

# Niveau de log : fatal | error | warn | info | debug | trace
# LOG_LEVEL=info

# Redis. Sans cette variable, l'etat des parties vit dans la memoire du process,
# ce qui suffit pour une instance unique. A ne renseigner que pour faire tourner
# plusieurs instances derriere un load balancer.
# REDIS_URL=redis://127.0.0.1:6379

# A renseigner UNIQUEMENT si le front est heberge sur un autre domaine que le
# serveur. En fonctionnement normal, tout est servi en meme origine.
# CORS_ORIGINS=https://mon-domaine.fr
